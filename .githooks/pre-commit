#!/bin/bash
#set -euo pipefail
#ROOT_DIR="$(git rev-parse --show-toplevel)"
#cd "$ROOT_DIR"

echo "FRAMEY pre-commit 실행"

echo "🚀 스테이징된 Java파일만 확인 중.. "
CHANGED_FILES=()
while IFS= read -r line; do
  [ -n "$line" ] && CHANGED_FILES+=("$line")
done < <(
  git diff --cached --name-only --diff-filter=ACMR |
  grep '\.java$' || true
)

if [ ${#CHANGED_FILES[@]} -eq 0 ]; then
  echo "➡️ 파일 변경 사항 없어 검사 생략.."
  exit 0
fi

# 중복 Gradle Task 방지
TASKS=()

add_task() {
  local t
  for t in ${TASKS[@]+"${TASKS[@]}"}; do
    [ "$t" = "$1" ] && return 0
  done
  TASKS+=("$1")
}

for file in "${CHANGED_FILES[@]}"; do
  case "$file" in
    framey-common/*)
      add_task ":framey-common:checkstyleMain"
      ;;
    framey-web/*)
      add_task ":framey-web:checkstyleMain"
      ;;
    framey-monitoring/*)
      add_task ":framey-monitoring:checkstyleMain"
      ;;
    framey-application/member-service/*)
      add_task ":framey-application:member-service:checkstyleMain"
      ;;
    framey-application/collage-service/*)
      add_task ":framey-application:collage-service:checkstyleMain"
      ;;
    framey-application/archive-service/*)
      add_task ":framey-application:archive-service:checkstyleMain"
      ;;
  esac
done

if [ ${#TASKS[@]} -eq 0 ]; then
  echo "☑️ 검사 대상 모듈 없음 ..."
  exit 0
fi

echo "⚠️ Checkstyle 검사 대상:"
printf '  %s\n' "${TASKS[@]}"

./gradlew "${TASKS[@]}" --no-daemon || {
  echo "⛔️ Checkstyle 실패 — 커밋 중단 (상세: build/reports/checkstyle/)"
  exit 1
}
echo "🔥 pre-commit 통과"

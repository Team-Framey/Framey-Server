<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
		"-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
		"https://checkstyle.org/dtds/configuration_1_3.dtd">

<!--
    Framey Checkstyle

    목적:
    - AI 생성 / 복사한 코드의 기본적인 스타일 오류 방지
    - 팀 코드 스타일의 최소한의 일관성 유지
    - 지나치게 세세한 포맷팅 규칙은 IDE Formatter에 위임
-->

<module name="Checker">

	<property name="severity" value="warning"/>
	<property name="fileExtensions" value="java"/>
	<property name="charset" value="UTF-8"/>
	<property name="tabWidth" value="4"/>


	<!-- ========================================================= -->
	<!-- File                                                      -->
	<!-- ========================================================= -->

	<!-- CRLF 금지, LF 사용 -->
	<module name="RegexpMultiline">
		<property name="format" value="\r\n"/>
		<property name="message"
		          value="[newline-lf] Line must end with LF, not CRLF."/>
	</module>

	<!-- 파일 마지막 줄바꿈 -->
	<module name="NewlineAtEndOfFile">
		<property name="lineSeparator" value="lf"/>
	</module>

	<!-- 줄 끝 불필요한 공백 금지 -->
	<module name="RegexpSingleline">
		<property name="format" value="^(?!\s+\* $).*?\s+$"/>
		<property name="message"
		          value="[no-trailing-spaces] Line has trailing spaces."/>
	</module>

	<!-- 한 줄 최대 120자 -->
	<module name="LineLength">
		<property name="max" value="120"/>
		<property name="ignorePattern"
		          value="^package.*|^import.*|a href|href|http://|https://|ftp://"/>
		<message key="maxLineLen"
		         value="[line-length-120] Line is longer than {0,number,integer} characters (found {1,number,integer})."/>
	</module>


	<module name="TreeWalker">

		<!-- ===================================================== -->
		<!-- Naming                                                -->
		<!-- ===================================================== -->

		<!-- 패키지는 소문자 -->
		<module name="PackageName">
			<property name="format" value="^[a-z]+(\.[a-z][a-z0-9]*)*$"/>
			<message key="name.invalidPattern"
			         value="[package-lowercase] Package name ''{0}'' must match pattern ''{1}''."/>
		</module>

		<!-- 클래스 / 인터페이스 / Enum: PascalCase -->
		<module name="TypeName"/>

		<!-- 메서드: camelCase -->
		<module name="MethodName">
			<property name="format" value="^[a-z][a-zA-Z0-9]*$"/>
			<message key="name.invalidPattern"
			         value="[method-camelcase] Method name ''{0}'' must match pattern ''{1}''."/>
		</module>

		<!-- 필드: camelCase -->
		<module name="MemberName">
			<property name="format" value="^[a-z][a-zA-Z0-9]*$"/>
			<message key="name.invalidPattern"
			         value="[field-camelcase] Member name ''{0}'' must match pattern ''{1}''."/>
		</module>

		<!-- 파라미터: camelCase -->
		<module name="ParameterName">
			<property name="format" value="^[a-z][a-zA-Z0-9]*$"/>
			<message key="name.invalidPattern"
			         value="[parameter-camelcase] Parameter name ''{0}'' must match pattern ''{1}''."/>
		</module>

		<!-- 지역 변수: camelCase -->
		<module name="LocalVariableName">
			<property name="tokens" value="VARIABLE_DEF"/>
			<property name="format" value="^[a-z][a-zA-Z0-9]*$"/>
			<property name="allowOneCharVarInForLoop" value="true"/>
			<message key="name.invalidPattern"
			         value="[local-variable-camelcase] Local variable name ''{0}'' must match pattern ''{1}''."/>
		</module>


		<!-- ===================================================== -->
		<!-- Declaration                                           -->
		<!-- ===================================================== -->

		<!-- 하나의 파일에는 하나의 top-level class -->
		<module name="OneTopLevelClass"/>

		<!-- * import 금지 -->
		<module name="AvoidStarImport">
			<property name="allowStaticMemberImports" value="false"/>
			<message key="import.avoidStar"
			         value="[avoid-star-import] Star import should be avoided: {0}."/>
		</module>

		<!-- public/static/final 등의 modifier 순서 -->
		<module name="ModifierOrder"/>

		<!-- 한 줄에 하나의 statement -->
		<module name="OneStatementPerLine"/>

		<!-- 변수 하나씩 선언 -->
		<module name="MultipleVariableDeclarations"/>

		<!-- 배열은 String[] 형태 사용 -->
		<module name="ArrayTypeStyle"/>

		<!-- long literal은 소문자 l 대신 L -->
		<module name="UpperEll"/>


		<!-- ===================================================== -->
		<!-- Braces                                                -->
		<!-- ===================================================== -->

		<!-- { 위치 -->
		<module name="LeftCurly"/>

		<!-- 일반 블록의 } 위치 -->
		<module name="RightCurly">
			<property name="option" value="alone"/>
			<property name="tokens"
			          value="CLASS_DEF,
                             METHOD_DEF,
                             CTOR_DEF,
                             LITERAL_FOR,
                             LITERAL_WHILE,
                             STATIC_INIT,
                             INSTANCE_INIT"/>
		</module>

		<!-- if/else, try/catch 등의 } else / } catch -->
		<module name="RightCurly">
			<property name="option" value="same"/>
			<property name="tokens"
			          value="LITERAL_TRY,
                             LITERAL_CATCH,
                             LITERAL_FINALLY,
                             LITERAL_IF,
                             LITERAL_ELSE,
                             LITERAL_DO"/>
		</module>

		<!-- if / for / while 등에 {} 필수 -->
		<module name="NeedBraces"/>

		<!-- ===================================================== -->
		<!-- Import                                                -->
		<!-- ===================================================== -->

		<!-- package/import 문장은 한 줄 -->
		<module name="NoLineWrap">
			<property name="tokens" value="PACKAGE_DEF,IMPORT"/>
		</module>

		<!-- ===================================================== -->
		<!-- Blank Line                                            -->
		<!-- ===================================================== -->

		<!-- 메서드 사이 빈 줄 -->
		<module name="EmptyLineSeparator">
			<property name="tokens" value="METHOD_DEF"/>
		</module>


		<!-- ===================================================== -->
		<!-- Whitespace                                            -->
		<!-- ===================================================== -->

		<!-- { } 주변 기본 공백 -->
		<module name="WhitespaceAround">
			<property name="allowEmptyConstructors" value="true"/>
			<property name="allowEmptyMethods" value="true"/>
			<property name="allowEmptyLoops" value="true"/>
			<property name="tokens"
			          value="LCURLY,RCURLY,SLIST"/>
		</module>

		<!-- if( → if ( / for( → for ( -->
		<module name="WhitespaceAround">
			<property name="tokens"
			          value="LITERAL_ASSERT,
                             LITERAL_CATCH,
                             LITERAL_DO,
                             LITERAL_ELSE,
                             LITERAL_FINALLY,
                             LITERAL_FOR,
                             LITERAL_IF,
                             LITERAL_RETURN,
                             LITERAL_SWITCH,
                             LITERAL_SYNCHRONIZED,
                             LITERAL_TRY,
                             LITERAL_WHILE"/>
		</module>

		<!-- method () 같은 형태 방지 -->
		<module name="MethodParamPad"/>

		<!-- 쉼표/세미콜론 앞 공백 금지 -->
		<!-- foo(a , b) / value ; 방지 -->
		<module name="NoWhitespaceBefore">
			<property name="tokens" value="COMMA,SEMI"/>
		</module>

		<!-- i ++ / i - 방지 -->
		<module name="NoWhitespaceBefore">
			<property name="tokens" value="POST_INC,POST_DEC"/>
		</module>

		<!-- = + - * / == && 등의 연산자 주변 공백 -->
		<module name="WhitespaceAround">
			<property name="tokens"
			          value="ASSIGN,
                             BAND,
                             BAND_ASSIGN,
                             BOR,
                             BOR_ASSIGN,
                             BSR,
                             BSR_ASSIGN,
                             BXOR,
                             BXOR_ASSIGN,
                             DIV,
                             DIV_ASSIGN,
                             EQUAL,
                             GE,
                             GT,
                             LAND,
                             LE,
                             LOR,
                             LT,
                             MINUS,
                             MINUS_ASSIGN,
                             MOD,
                             MOD_ASSIGN,
                             NOT_EQUAL,
                             PLUS,
                             PLUS_ASSIGN,
                             QUESTION,
                             SL,
                             SL_ASSIGN,
                             SR,
                             SR_ASSIGN,
                             STAR,
                             STAR_ASSIGN,
                             TYPE_EXTENSION_AND"/>
		</module>


		<!-- ===================================================== -->
		<!-- Suppression                                           -->
		<!-- ===================================================== -->

		<!--
            특정 영역 검사 제외:

            // @checkstyle:off
            ...
            // @checkstyle:on
        -->
		<module name="SuppressionCommentFilter">
			<property name="offCommentFormat" value="@checkstyle:off"/>
			<property name="onCommentFormat" value="@checkstyle:on"/>
		</module>

		<!-- 해당 줄만 검사 제외 -->
		<!-- // @checkstyle:ignore -->
		<module name="SuppressWithNearbyCommentFilter">
			<property name="commentFormat" value="@checkstyle:ignore"/>
			<property name="checkFormat" value=".*"/>
			<property name="influenceFormat" value="0"/>
		</module>

	</module>


	<!-- suppression.xml 지원 -->
	<module name="SuppressionFilter">
		<property name="file" value="${suppressionFile}"/>
		<property name="optional" value="true"/>
	</module>

	<!-- module-info.java 제외 -->
	<module name="BeforeExecutionExclusionFileFilter">
		<property name="fileNamePattern" value="module\-info\.java$"/>
	</module>

</module>